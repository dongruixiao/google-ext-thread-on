{
  "manifest_version": 3,
  "name": "TopClip — 读长文，不掉线",
  "description": "读长文不掉线：用可拖动的拟物章节胶囊提醒当前章节，悬停展开目录，并显示整篇阅读进度。",
  "version": "0.13.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TopClip",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "在当前站点启用 / 禁用章节胶囊"
    },
    "toggle-global": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "全局启用 / 禁用章节胶囊"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage"]
}
