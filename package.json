{
  "name": "web-sticky-scroll",
  "private": true,
  "version": "0.10.1",
  "type": "module",
  "description": "TopClip —— 读长文，不掉线（网页章节标题常驻顶部；类 VS Code Sticky Scroll 的阅读体验）",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/extension.mjs",
    "field-check": "node e2e/field-check.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "demo:dev": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "demo:preview": "vite preview --config vite.demo.config.ts --port 5199 --strictPort"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
